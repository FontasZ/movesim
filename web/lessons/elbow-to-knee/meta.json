 "captions": [
  {
   "start": 0.5,
   "end": 3.5,
   "text": "Lie on your back, knees bent, feet standing, arms long."
  },
  {
   "start": 3.5,
   "end": 16.01,
   "text": "Lift the left knee a little toward you, so the foot leaves the floor, and put it back."
  },
  {
   "start": 16.01,
   "end": 39.01,
   "text": "Bring the right elbow toward the left knee as the knee comes toward you. Let the head lift a little with it."
  },
  {
   "start": 39.01,
   "end": 54.52,
   "text": "The same, but leave the head on the floor: only the elbow and the knee come toward each other."
  },
  {
   "start": 54.52,
   "end": 65.52,
   "text": "The whole diagonal once more, with the head. Notice how far the elbow and the knee come now."
  }
 ],
