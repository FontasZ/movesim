  {
   "start": 0.5,
   "end": 2.5,
   "text": "Sit on the front half of the chair, feet standing on the floor."
  },
  {
   "start": 2.5,
   "end": 10.5,
   "text": "Turn the head to the right, as if to look behind you, and come back."
  },
  {
   "start": 10.5,
   "end": 26.01,
   "text": "Turn the chest to the right as well, the head going with it. Come back."
  },
  {
   "start": 26.01,
   "end": 41.51,
   "text": "Turn the chest to the right and the head to the left, at the same time. Small."
  },
  {
   "start": 41.51,
   "end": 57.02,
   "text": "Leave the head facing forward and turn only the chest to the right, and back."
  },
  {
   "start": 57.02,
   "end": 68.52,
   "text": "Turn head and chest together to the right once more, and notice how far you see now."
  }
