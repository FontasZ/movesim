 "captions": [
  {
   "start": 0.5,
   "end": 4.5,
   "text": "Lie on your back, knees bent, feet standing. Notice how your back meets the floor."
  },
  {
   "start": 4.5,
   "end": 26.01,
   "text": "Slowly let both knees go a little to the right, and come back to the middle."
  },
  {
   "start": 26.01,
   "end": 47.51,
   "text": "Now let the knees go to the left and come back. Is it the same as to the right?"
  },
  {
   "start": 47.51,
   "end": 51.52,
   "text": "Let the knees go to the right and leave them there."
  },
  {
   "start": 51.52,
   "end": 72.52,
   "text": "Now roll your head to the left, and back to the middle."
  },
  {
   "start": 72.52,
   "end": 74.52,
   "text": "Bring the knees back to the middle."
  },
  {
   "start": 74.52,
   "end": 93.02,
   "text": "Press lightly through the right foot, so the right knee goes forward a little. Notice how the right side of the pelvis lifts."
  }
 ],
