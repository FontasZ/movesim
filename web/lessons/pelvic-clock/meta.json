 "captions": [
  {
   "start": 0.5,
   "end": 4.5,
   "text": "Imagine the back of your pelvis on a clock face: 12 toward your head, 6 toward your feet, 3 at your left hip, 9 at your right hip."
  },
  {
   "start": 4.5,
   "end": 23.01,
   "text": "Gently press the pelvis toward 12, the lower back coming toward the floor, and let it return."
  },
  {
   "start": 23.01,
   "end": 41.51,
   "text": "Now toward 6: the tailbone presses and the lower back lifts away from the floor. Notice what the head does."
  },
  {
   "start": 41.51,
   "end": 46.81,
   "text": "Go between 12 and 6, slowly. Toward 12\u2026"
  },
  {
   "start": 46.81,
   "end": 52.12,
   "text": "\u2026and toward 6."
  },
  {
   "start": 52.12,
   "end": 57.42,
   "text": "Toward 12 again\u2026"
  },
  {
   "start": 57.42,
   "end": 63.72,
   "text": "\u2026and 6."
  },
  {
   "start": 63.72,
   "end": 68.72,
   "text": "Rest."
  },
  {
   "start": 68.72,
   "end": 81.23,
   "text": "Roll the pelvis toward 3, your left hip, and back."
  },
  {
   "start": 81.23,
   "end": 93.73,
   "text": "Then toward 9, your right hip, and back."
  },
  {
   "start": 93.73,
   "end": 106.23,
   "text": "The diagonals: toward half past one, between 12 and 3, and back."
  },
  {
   "start": 106.23,
   "end": 118.73,
   "text": "Then toward half past seven, between 6 and 9, and back."
  },
  {
   "start": 118.73,
   "end": 123.73,
   "text": "Rest."
  },
  {
   "start": 123.73,
   "end": 140.73,
   "text": "Now go around the clock: 12, 3, 6, 9, and back to 12, slowly, touching each hour."
  },
  {
   "start": 140.73,
   "end": 157.73,
   "text": "Then the other way around: 12, 9, 6, 3."
  },
  {
   "start": 157.73,
   "end": 162.73,
   "text": "Rest, and notice how the back of your pelvis and your lower back lie on the floor now."
  }
 ],
 "props": [],
 "seconds": 162.73
